{
  "name": "drift-browser",
  "productName": "Drift",
  "version": "1.0.1",
  "description": "Drift — a calm, sidebar-first Chromium browser for macOS",
  "main": "src/main/main.js",
  "author": "Nishanth Anand",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "icon": "electron scripts/make-icon.js",
    "build": "electron-builder --mac",
    "build:dir": "electron-builder --dir",
    "release": "electron-builder --mac --publish always",
    "postinstall": "node scripts/bundle-preload.js",
    "prestart": "node scripts/bundle-preload.js",
    "security": "npm audit --omit=dev && npx --yes @doyensec/electronegativity@1.10.3 -i src -e 45.0.0 -o security-report.csv"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@ghostery/adblocker": "^2.20.1",
    "electron-chrome-extensions": "^4.9.0",
    "electron-chrome-web-store": "^0.13.0",
    "electron-updater": "^6.8.11",
    "tldts-experimental": "^7.4.19"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "app.drift.browser",
    "productName": "Drift",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSCameraUsageDescription": "Websites you allow can use your camera.",
        "NSMicrophoneUsageDescription": "Websites you allow can use your microphone.",
        "NSLocationUsageDescription": "Websites you allow can use your location."
      },
      "minimumSystemVersion": "12.0"
    },
    "protocols": [
      {
        "name": "Web URL",
        "schemes": [
          "http",
          "https"
        ]
      }
    ],
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "NishanthAnand21",
        "repo": "drift",
        "releaseType": "release"
      }
    ],
    "asarUnpack": [
      "src/mcp/**"
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "loadBrowserProcessSpecificV8Snapshot": false,
      "grantFileProtocolExtraPrivileges": false
    },
    "copyright": "Copyright © 2026 Nishanth Anand"
  },
  "overrides": {
    "adm-zip": "0.6.1"
  }
}
